# Credenciales de la API de Clientify.
# Solo se usan en desarrollo local (via .env). En Streamlit Cloud, configurá
# estas mismas claves en .streamlit/secrets.toml (ver .streamlit/secrets.toml.example)
# — settings.py prioriza st.secrets y cae acá solo si no está configurado.
CLIENTIFY_API_TOKEN=tu_token_aqui
CLIENTIFY_BASE_URL=https://api.clientify.net/v1

# Configuración de la app
APP_TITLE=Clientify Analyzer
APP_TIMEZONE=America/Bogota
