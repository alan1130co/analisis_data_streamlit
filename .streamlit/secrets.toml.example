# Plantilla de secrets para Streamlit Cloud (y opcionalmente desarrollo local).
#
# Copiá este archivo a .streamlit/secrets.toml (ya está en .gitignore, NUNCA
# se sube al repo) y reemplazá los valores por los reales. En Streamlit
# Cloud, pegá el mismo contenido en Settings → Secrets de la app.

app_password = "tu_contraseña_aqui"
CLIENTIFY_API_TOKEN = "tu_token_aqui"

# Meta Ads (Marketing API) — ver scripts/diagnostic_meta_api.py
META_ACCESS_TOKEN = "tu_token_aqui"
META_AD_ACCOUNT_ID_INTERNA = "tu_ad_account_id_aqui"
META_AD_ACCOUNT_ID_SOLUCIONES = "tu_ad_account_id_aqui"
META_AD_ACCOUNT_ID_CONTINGENCIA = "tu_ad_account_id_aqui"
